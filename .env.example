# Google AI Studio API key (https://aistudio.google.com/app/apikey) - required
GOOGLE_API_KEY=your_google_api_key_here

# Tavily API key (https://app.tavily.com) - required, free tier available
TAVILY_API_KEY=your_tavily_api_key_here

# Gemini model to use. gemini-3.6-flash is fast/cheap and has generous free-tier
# quota; switch to gemini-3.6-pro for higher-quality reasoning if you have quota.
GEMINI_MODEL=gemini-3.6-flash

# Comma-separated fallback models, tried in order if GEMINI_MODEL's free-tier
# quota (per model, per day) runs out mid-session. Only used on an actual
# quota/rate-limit error -- any other error still fails immediately.
GEMINI_FALLBACK_MODELS=gemini-3.8-flash,gemini-flash-lite-latest,gemini-3.5-flash-lite,gemini-3.1-flash-lite

# Max number of planner<->evaluator loop iterations before forcing report generation
MAX_PLANNER_ITERATIONS=2

# Max search results fetched per sub-query from Tavily
MAX_RESULTS_PER_QUERY=4
